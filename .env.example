# Telegram Mini App
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Keep true for browser demos before the bot token is configured. Set false in production after Telegram is connected.
ALLOW_DEMO_MODE=true

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional persistent storage (Upstash Redis REST API)
KV_REST_API_URL=
KV_REST_API_TOKEN=
